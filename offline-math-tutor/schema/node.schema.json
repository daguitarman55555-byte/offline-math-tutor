{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/math-node-v4.json",
  "title": "Math Tutor Node v4",
  "description": "Minimal stable authoring contract. UI layout, localization, analytics, and scheduler state live outside the node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "order",
    "title",
    "objective",
    "prerequisites",
    "lesson",
    "hints",
    "generators",
    "misconceptions",
    "mastery",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Permanent semantic identity. Never change this merely to reorder the spine."
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "Editable display order; not an identity or prerequisite key."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "One observable learner outcome."
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "lesson": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered, renderer-independent lesson blocks.",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered from least revealing to most revealing.",
      "items": {
        "$ref": "#/$defs/hint"
      }
    },
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/generator"
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/misconception"
      },
      "minItems": 3
    },
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minAttempts",
        "requiredAccuracy",
        "maxHintRate"
      ],
      "properties": {
        "minAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "requiredAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxHintRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle",
        "generatedCaseCount"
      ],
      "properties": {
        "oracle": {
          "type": "string",
          "enum": [
            "value",
            "exact",
            "symbolic-equivalence",
            "numeric-sampling",
            "derivative-check",
            "equation-classification",
            "custom"
          ]
        },
        "generatedCaseCount": {
          "type": "integer",
          "minimum": 30
        },
        "domain": {
          "type": "string",
          "description": "Machine-readable domain expression interpreted by the selected oracle."
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "kind": {
              "const": "explain"
            },
            "body": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "kind": {
              "const": "math"
            },
            "body": {
              "type": "object",
              "required": [
                "latex"
              ],
              "properties": {
                "latex": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "kind": {
              "const": "example"
            },
            "body": {
              "type": "object",
              "required": [
                "prompt"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true,
              "anyOf": [
                {
                  "required": [
                    "steps"
                  ]
                },
                {
                  "required": [
                    "cases"
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "kind": {
              "const": "check"
            },
            "body": {
              "type": "object",
              "required": [
                "prompt"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "kind": {
              "const": "visual"
            },
            "body": {
              "type": "object",
              "required": [
                "visualType"
              ],
              "properties": {
                "visualType": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "learnerVariables",
        "problem",
        "parameters",
        "constraints",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "description": "Generator-specific parameter definition such as integer range or choice set."
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "supportedRules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Optional whitelist for limited step grading."
        },
        "learnerVariables": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          }
        },
        "problem": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "misconception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "detector",
        "feedback"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "detector": {
          "type": "string",
          "minLength": 1,
          "description": "Named deterministic detector implemented and tested in code."
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": [
                "number",
                "boolean"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "var"
          ],
          "properties": {
            "var": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "mod",
                "equal",
                "not-equal",
                "less",
                "less-equal",
                "greater",
                "greater-equal",
                "and",
                "or",
                "between-inclusive"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "one"
            },
            "value": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "none",
                "infinite"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/expression"
            }
          }
        }
      ]
    }
  }
}
