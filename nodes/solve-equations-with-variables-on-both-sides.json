{
  "schemaVersion": 4,
  "id": "solve-equations-with-variables-on-both-sides",
  "order": 172,
  "title": "Solve equations with variables on both sides",
  "objective": "Solve a linear equation with variable terms on both sides and classify it as having one solution, no solution, or infinitely many solutions.",
  "prerequisites": [
    "combine-like-terms",
    "distribute-signed-factors",
    "solve-multi-step-linear-equations"
  ],
  "lesson": [
    {
      "id": "meaning-of-solution",
      "kind": "explain",
      "body": {
        "text": "A solution is a value that makes both sides of an equation equal. Each operation must preserve that equality."
      }
    },
    {
      "id": "collect-variable-terms",
      "kind": "explain",
      "body": {
        "text": "First collect the variable terms on one side. Then collect the constants on the other side and isolate the variable."
      }
    },
    {
      "id": "unique-solution-example",
      "kind": "example",
      "body": {
        "prompt": "Solve 5x + 2 = 3x + 10.",
        "steps": [
          {
            "math": "5x + 2 = 3x + 10",
            "reason": "Original equation"
          },
          {
            "math": "2x + 2 = 10",
            "reason": "Subtract 3x from both sides"
          },
          {
            "math": "2x = 8",
            "reason": "Subtract 2 from both sides"
          },
          {
            "math": "x = 4",
            "reason": "Divide both sides by 2"
          }
        ],
        "check": "5(4) + 2 = 22 and 3(4) + 10 = 22"
      }
    },
    {
      "id": "special-cases",
      "kind": "example",
      "body": {
        "prompt": "Classify equations after the variable terms cancel.",
        "cases": [
          {
            "math": "4x + 3 = 4x + 3",
            "result": "Infinitely many solutions because the remaining statement is always true."
          },
          {
            "math": "4x + 3 = 4x - 2",
            "result": "No solution because the remaining statement is false."
          }
        ]
      }
    },
    {
      "id": "classification-check",
      "kind": "check",
      "body": {
        "prompt": "After simplifying, what does 0 = 0 mean?",
        "choices": [
          "One solution",
          "No solution",
          "Infinitely many solutions"
        ],
        "answerIndex": 2,
        "feedback": "The statement is true for every permitted value of the variable."
      }
    }
  ],
  "hints": [
    {
      "id": "choose-variable-side",
      "body": "Choose which side will keep the variable terms. A side with the larger variable coefficient often avoids negative coefficients."
    },
    {
      "id": "remove-variable-term",
      "body": "Use an inverse operation on both sides to remove the variable term from the other side."
    },
    {
      "id": "collect-constants",
      "body": "Move the remaining constant away from the variable by applying the same inverse operation to both sides."
    },
    {
      "id": "classify-cancellation",
      "body": "If the variable cancels, decide whether the remaining numerical statement is always true or false."
    }
  ],
